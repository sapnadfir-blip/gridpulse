%% ================================================================
%%  SECTION V: PRIORITY QUEUE ADMISSION CONTROLLER
%% ================================================================
\section{Priority Queue Admission Controller (PQAC)}
\label{sec:pqac}

\begin{figure}[t]
\centering
\includegraphics[width=0.95\columnwidth]{fig1_latency_vs_attack_rate.pdf}
\caption{End-to-end trip delivery latency vs.\ attack rate for RSA-2048 under FIFO vs.\ PQAC. FIFO queues exceed the 3\,ms deadline at all rates $\ge$10K\,pps (reaching 2,318\,ms); PQAC preserves sub-0.1\,ms latency across all evaluated attack rates up to 100K\,pps ($<$0.2\,ms at 500K\,pps).}
\label{fig:latency_vs_rate}
\end{figure}

\subsection{Three-Stage Classification Pipeline}
PQAC sits directly between the network raw socket and verification workers, executing $O(1)$ triage per frame in $<0.2\,\mu$s (Algorithm~\ref{alg:pqac}):
\begin{enumerate}[leftmargin=*]
    \item \textbf{Stage 1 (MAC \& Allowlist Verification):} Source MAC addresses are cross-referenced against the pre-provisioned SCD allowlist $\mathcal{M}$ (or dynamic table).
    \item \textbf{Stage 2 (Plausibility \& Transition Budget Gating):} For allowlisted publishers, state transitions ($F.\text{stNum}$) are evaluated using RFC 1982 serial arithmetic: $\Delta = (F.\text{stNum} \ominus \text{last\_verified\_st})$. To prevent spoofed $F.\text{stNum}$ fast-path saturation and state poisoning:
    \begin{itemize}[leftmargin=*]
        \item \emph{Plausibility Window:} Transitions are plausible only if $\Delta \in (0, W]$ with window size $W = 16$.
        \item \emph{Transition Token Bucket:} Admissions to HIGH are metered by a per-publisher transition token bucket $\mathcal{B}_{\text{trans}}$ ($B = 5$ tokens burst, refill rate $R = 2$\,tokens/s), matching the physical reality that breaker trips occur sparsely.
        \item \emph{Verify-Before-Commit:} Crucially, the verified state counter $\mathcal{S}_{\text{ver}}[\text{src\_mac}]$ is \emph{not} updated during ingestion triage. It is committed strictly inside the worker thread upon successful cryptographic verification, preventing state poisoning and trip suppression.
    \end{itemize}
    \item \textbf{Stage 3 (Rate Anomaly Triage \& Wire-Speed Drop):} Per-source packet counters $C$ and aggregate HIGH admissions $\text{admitted}_H$ are evaluated:
    \begin{itemize}[leftmargin=*]
        \item For known publishers: $C \le T_{\text{normal}}$ (50\,pps) enters HIGH (subject to aggregate cap $\Lambda_H^{\max} \le 500$\,pps); $T_{\text{normal}} < C \le T_{\text{burst}}$ (500\,pps) enters NORMAL; rates $C > T_{\text{burst}}$ trigger flood containment ($\alpha = 0.01$ sampled to LOW, 99\% dropped at wire speed).
        \item For unknown sources: low-rate traffic ($C \le T_{\text{normal}}$) enters LOW for isolated monitoring; flood traffic ($C > T_{\text{normal}}$) is sampled at $\alpha = 0.01$ to LOW, and 99\% is dropped immediately.
    \end{itemize}
\end{enumerate}

\begin{algorithm}[t]
\caption{PQAC Classification and Admission Control (v3)}
\label{alg:pqac}
\scriptsize
\begin{algorithmic}[1]
\REQUIRE Frame $F$, MAC allowlist $\mathcal{M}$, rate tracker $\mathcal{R}$, verified state tracker $\mathcal{S}_{\text{ver}}$, token bucket $\mathcal{B}_{\text{trans}}$, aggregate cap $\Lambda_H^{\max}$, plausibility window $W=16$
\STATE Extract $\text{mac} \leftarrow F.\text{ether\_shost}$, $\text{stNum} \leftarrow F.\text{stNum}$
\IF{$\text{mac} \in \mathcal{M}$}
    \STATE $\text{last\_st} \leftarrow \mathcal{S}_{\text{ver}}[\text{mac}]$
    \STATE $\Delta \leftarrow (\text{stNum} \ominus \text{last\_st})$ \COMMENT{RFC 1982 Serial Number Comparison}
    \IF{$\Delta \in (0, W]$ \AND $\text{consume\_token}(\mathcal{B}_{\text{trans}}[\text{mac}])$ \AND $\text{admitted}_H < \Lambda_H^{\max}$}
        \STATE $\text{admitted}_H \leftarrow \text{admitted}_H + 1$
        \STATE \textbf{enqueue}($\text{queue}_{\text{HIGH}}, F$); \textbf{return} \COMMENT{Gated Protection Transition}
    \ENDIF
    \STATE $C \leftarrow \mathcal{R}[\text{mac}]$ \COMMENT{Evaluate Publisher Rate}
    \IF{$C \le T_{\text{normal}}$ \AND $\text{admitted}_H < \Lambda_H^{\max}$}
        \STATE $\text{admitted}_H \leftarrow \text{admitted}_H + 1$
        \STATE \textbf{enqueue}($\text{queue}_{\text{HIGH}}, F$) \COMMENT{Nominal Heartbeat}
    \ELSIF{$C \le T_{\text{burst}}$}
        \STATE \textbf{enqueue}($\text{queue}_{\text{NORMAL}}, F$) \COMMENT{Retransmission Burst}
    \ELSE
        \IF{$\text{random}() < \alpha$}
            \STATE \textbf{enqueue}($\text{queue}_{\text{LOW}}, F$) \COMMENT{Sampled Telemetry}
        \ELSE
            \STATE $\text{drop}(F)$ \COMMENT{Wire-Speed Known Flood Drop}
        \ENDIF
    \ENDIF
\ELSE
    \STATE $C \leftarrow \mathcal{R}[\text{mac}]$ \COMMENT{Evaluate Unknown Source Rate}
    \IF{$C \le T_{\text{normal}}$}
        \STATE \textbf{enqueue}($\text{queue}_{\text{LOW}}, F$) \COMMENT{Unverified Device Discovery}
    \ELSE
        \IF{$\text{random}() < \alpha$}
            \STATE \textbf{enqueue}($\text{queue}_{\text{LOW}}, F$) \COMMENT{Sampled Telemetry}
        \ELSE
            \STATE $\text{drop}(F)$ \COMMENT{Wire-Speed Unknown Drop}
        \ENDIF
    \ENDIF
\ENDIF
\STATE \COMMENT{Note: $\mathcal{S}_{\text{ver}}[\text{mac}] \leftarrow \text{stNum}$ is updated ONLY upon verified signature in worker}
\end{algorithmic}
\end{algorithm}

\subsection{Theoretical Stability and Delay Bounds}
Let $\mathcal{K} = \{H, N, L\}$ denote priority classes where $H \succ N \succ L$.

\begin{theorem}[Queue Stability under Bounded Aggregate Admission]
\label{thm:stability}
Let total arrival rate be $\lambda = \lambda_{\text{legit}} + \lambda_{\text{atk}}$, with attack rate $\lambda_{\text{atk}} \to \infty$. Under PQAC with aggregate HIGH cap $\Lambda_H^{\max} \le 500$\,pps, the high-priority protection queue is unconditionally stable ($\rho_H < 1$) independent of flood intensity or active publisher count $M$:
\begin{equation}
\rho_H = \frac{\lambda_H}{\mu} \le \frac{\min\left(\sum_{i=1}^M \lambda_i^H, \Lambda_H^{\max}\right)}{\mu} \le \frac{\Lambda_H^{\max}}{\mu} < 1.
\end{equation}
\end{theorem}
\begin{proof}
By Cobham's priority theorem~\cite{cobham1954priority}, Class~$H$ waiting time in an $M/G/1$ priority queue is $W_H = \frac{R}{1 - \rho_H}$, where residual service time $R = \frac{1}{2} \sum \lambda_k \overline{S_k^2} \le S_{\max}$. Because Class~$H$ frames bypass lower classes and total Class~$H$ admissions are capped at $\Lambda_H^{\max} = 500$\,pps, Class~$H$ behaves as an independent $M/G/1$ queue with arrival rate $\lambda_H \le 500$\,pps. On embedded relays (ARM Cortex-A9, $\mu = 1{,}745$\,fps), $\rho_H \le 500/1{,}745 = 0.2865 < 1$. On industrial gateways ($\mu = 3{,}704$\,fps), $\rho_H \le 0.1350 < 1$. On our benchmark host ($\mu = 29{,}689$\,fps), $\rho_H \le 0.0168 \ll 1$. In all cases, Class~$H$ is strictly sub-critical, ensuring an ergodic stationary queue length distribution with finite moments.
\end{proof}

\begin{theorem}[Attack Traffic Isolation]
\label{thm:isolation}
Under non-preemptive priority scheduling, waiting time $W_H$ for legitimate trip commands is invariant to LOW queue depth $Q_L$ and attack rate $\lambda_{\text{atk}}$:
\begin{equation}
\frac{\partial \mathbb{E}[W_H]}{\partial Q_L} = 0 \quad \text{and} \quad \frac{\partial \mathbb{E}[W_H]}{\partial \lambda_{\text{atk}}} = 0 \quad \forall \lambda_{\text{atk}} \ge T_{\text{flood}}.
\end{equation}
\end{theorem}
\begin{proof}
Verification workers select frames from queue $L$ strictly when $Q_H = Q_N = 0$. An arriving Class~$H$ frame waits behind at most $Q_H$ prior high-priority frames plus at most one in-flight frame. Since $Q_L$ never enters the state transitions of Class~$H$, Class~$H$ is decoupled from attack traffic.
\end{proof}

\begin{theorem}[Theoretical Upper Bound on Trip Latency]
\label{thm:deadline}
For an admitted legitimate trip frame arriving during steady-state CIL-DoS flood with 1 verification worker when $Q_H = 0$, the end-to-end trip latency on relay architectures where $S_{\max} + \overline{S} < 3.0$\,ms is strictly bounded from above by:
\begin{equation}
T_{\text{trip}} \le t_{\text{ingest}} + S_{\max} + \overline{S} + t_{\text{logic}} < 3.0\,\text{ms}.
\end{equation}
\end{theorem}
\begin{proof}
In the worst-case non-preemptive scenario, an attack frame begins verification at $t_0 - \epsilon$. Residual time until completion is at most $S_{\max}$. The incoming trip frame is classified into Class~$H$ in $t_{\text{ingest}} \le 1\,\mu$s. It is verified immediately upon worker availability ($\overline{S}$). Including protection logic ($t_{\text{logic}} \le 50\,\mu$s), on an ARM Cortex-A9 relay ($\overline{S} = 573\,\mu$s):
$T_{\text{trip}} \le 1 + 573 + 573 + 50 = 1{,}197\,\mu\text{s} \approx 1.20\,\text{ms} < 3.0\,\text{ms}$. On our benchmark host ($\overline{S} \approx 33.7\,\mu$s):
$T_{\text{trip}} \le 0.2 + 33.7 + 33.7 + 5.0 = 72.6\,\mu\text{s} \ll 3.0\,\text{ms}$.
Both tiers guarantee compliance with the IEC~61850 Class~P2/P3 3\,ms deadline when $Q_H=0$ (the physical reality, as breaker operations are rare events). If $k$ prior Class~$H$ frames exist from simultaneous multi-breaker trips, $T_{\text{trip}} \le t_{\text{ingest}} + S_{\max} + (k+1)\overline{S} + t_{\text{logic}}$, which preserves sub-3\,ms timing for $k \le 2$ on Cortex-A9 and $k \le 86$ on the host.
For deeply constrained legacy microcontrollers (Cortex-R5 with $\overline{S} = 2{,}704\,\mu$s, Cortex-M4 with $\overline{S} = 10{,}142\,\mu$s), software RSA-2048 verification inherently exceeds 3\,ms without queueing; achieving sub-3\,ms timing on those cores requires hardware cryptographic coprocessors or lightweight PQC (FALCON-512).
\end{proof}

\subsection{Computational and Memory Complexity}
PQAC executes in $O(1)$ amortized time: allowlist lookup requires $O(1)$ operations, rate comparison requires 3 integer comparisons, and enqueue/dequeue on ring buffers takes $O(1)$ pointer adjustments. State memory is strictly bounded by $O(K)$ pre-allocated entries for $K=256$ SCD-provisioned publishers plus a bounded $L=1{,}024$-entry LRU sketch for transient or unlisted MACs, requiring $<64$\,KB of RAM total. This strict $O(1)$ memory bound prevents state exhaustion attacks by adversaries rotating random MAC addresses.

%% ================================================================
%%  SECTION VI: EXPERIMENTAL SETUP AND METHODOLOGY
%% ================================================================
\section{Experimental Setup and Methodology}
\label{sec:experiments}

The testbed executes in Docker containers interconnected via a dedicated Layer~2 Linux bridge with MTU 9,000 (accommodating PQC jumbo frames):
(1)~\textbf{Publisher:} Emits authenticated GOOSE frames conforming to IEC~61850 heartbeat ($T_{\max} = 1{,}000$\,ms) and fault trip burst curves ($T_0 = 1, 2, 4, 8\dots$\,ms),
(2)~\textbf{Subscriber:} Implements our two-thread decoupled architecture with configurable FIFO vs.\ PQAC triage,
(3)~\textbf{Attacker:} Injects CIL-DoS flood frames across parametric rates (10K to 500K\,pps) with randomized signatures and spoofed MAC options.
All benchmarks were executed on an 8-core ARMv8.5 host (3.49\,GHz, 16\,GB RAM) using OpenSSL 3.0 and liboqs 0.10.0.

To evaluate CIL-DoS and PQAC comprehensively, we executed \textbf{49 controlled experimental trials} spanning eight testing dimensions:
(1)~\emph{Attack Rate Scaling} (5 rates $\times$ 2 queue modes = 10 trials; Figs.~\ref{fig:latency_vs_rate}--\ref{fig:deadline_miss});
(2)~\emph{Buffer Bloat Scaling} (4 queue depths = 4 trials; Fig.~\ref{fig:buffer_workers}a);
(3)~\emph{Multi-Worker Scaling} (4 thread configurations = 4 trials; Fig.~\ref{fig:buffer_workers}b);
(4)~\emph{Threshold Sensitivity Sweeps} (6 $T_{\text{flood}}$ settings = 6 trials; Table~\ref{tab:sensitivity_scalability});
(5)~\emph{Multi-Publisher Scalability} (4 publisher counts = 4 trials; Table~\ref{tab:sensitivity_scalability});
(6)~\emph{Component Ablation} (5 architectural configurations = 5 trials; Table~\ref{tab:ablation_pqc});
(7)~\emph{Post-Quantum Suite} (4 PQC algorithms $\times$ 3 modes + 1 signing benchmark = 13 trials; Table~\ref{tab:ablation_pqc}); and
(8)~\emph{MAC Spoofing Stress Tests} (3 attack rates = 3 trials).
Each trial evaluated a 60-second window across 10 independent repetitions per setting ($N > 10{,}000$ protection frames measured per data point), yielding empirical 95\% confidence intervals within $\pm 1.2\,\mu$s on mean latency and $\pm 0.08\%$ on miss ratios. In unmitigated FIFO runs under saturated flood ($\lambda_{\text{atk}} \gg \mu$), observed waiting times match theoretical $M/M/1/K$ and $M/D/1/K$ queueing physics ($W_{\text{sat}} = K \cdot \overline{S}$) within $\pm 0.8\%$ empirical variance.

